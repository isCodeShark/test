# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical URL of this deployment (no trailing slash).
# Used for magic-link redirects, Open Graph URLs and the .ics event link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. When set, {slug}.<root domain> is served as /{slug}.
# Requires a wildcard domain on the Vercel project. Leave unset for v1.
# NEXT_PUBLIC_ROOT_DOMAIN=example.com
